{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/siswa/kelas/[kelas]",
      "regex": "^/admin/siswa/kelas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkelas": "nxtPkelas"
      },
      "namedRegex": "^/admin/siswa/kelas/(?<nxtPkelas>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/proxy/[...path]",
      "regex": "^/api/proxy/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/proxy/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/qism/kelas/[kelas]",
      "regex": "^/qism/kelas/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPkelas": "nxtPkelas"
      },
      "namedRegex": "^/qism/kelas/(?<nxtPkelas>[^/]+?)(?:/)?$"
    },
    {
      "page": "/qism/siswa/[id]",
